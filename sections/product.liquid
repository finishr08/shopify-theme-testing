    min-height: 56px;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 14px 24px;
    color: var(--product-button-color);
    cursor: pointer;
    background: var(--product-button-background);
    border: 1px solid var(--product-button-background);
    border-radius: 14px;
    font-size: 15px;
    font-weight: 750;
