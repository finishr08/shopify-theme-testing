    color: #b33c35;
  }

  .custom-product__sku {
    color: var(--product-muted-color);
    font-size: 12px;
  }

  .custom-product__purchase-row {
    display: grid;
    grid-template-columns: 126px minmax(0, 1fr);
    gap: 14px;
    align-items: end;
    margin-top: 26px;
  }

  .custom-product__quantity-control {
