{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% render 'css-variables' %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}

    {% style %}
      :root {
        --gift-card-background: #f4f3ef;
        --gift-card-surface: #ffffff;
        --gift-card-heading: #161616;
        --gift-card-text: #66645f;
        --gift-card-border: #e6e3dc;
        --gift-card-accent: #b08a5a;
        --gift-card-accent-dark: #8f6b40;
        --gift-card-code-background: #f5f1e9;
        --gift-card-shadow: 0 30px 80px rgba(24, 20, 15, 0.12);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
      }

      body {
        min-height: 100vh;
        margin: 0;
        color: var(--gift-card-heading);
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(
            circle at top left,
            rgba(176, 138, 90, 0.16),
            transparent 35%
          ),
          radial-gradient(
            circle at bottom right,
            rgba(176, 138, 90, 0.12),
            transparent 40%
          ),
          var(--gift-card-background);
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
      }

      .gift-card-page {
        position: relative;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        overflow: hidden;
      }

      .gift-card-page__shape {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(1px);
      }

      .gift-card-page__shape--one {
        top: -120px;
        left: -100px;
        width: 320px;
        height: 320px;
        background: rgba(176, 138, 90, 0.14);
      }

      .gift-card-page__shape--two {
        right: -130px;
        bottom: -150px;
        width: 400px;
        height: 400px;
        background: rgba(176, 138, 90, 0.12);
      }

      .gift-card-page__container {
        position: relative;
        z-index: 2;
        width: min(100%, 1120px);
      }

      .gift-card-page__header {
        margin-bottom: 26px;
        text-align: center;
      }

      .gift-card-page__brand {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }

      .gift-card-page__brand img {
        width: auto;
        max-width: 220px;
        max-height: 72px;
        object-fit: contain;
      }

      .gift-card-page__brand-name {
        margin: 0;
        color: var(--gift-card-heading);
        font-size: 28px;
        font-weight: 750;
        line-height: 1.2;
        letter-spacing: -0.03em;
      }

      .gift-card-page__layout {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
        overflow: hidden;
        background: var(--gift-card-surface);
        border: 1px solid rgba(22, 22, 22, 0.06);
        border-radius: 32px;
        box-shadow: var(--gift-card-shadow);
      }

      .gift-card-page__visual-panel {
        position: relative;
        display: flex;
        min-height: 610px;
        align-items: center;
        justify-content: center;
        padding: 60px;
        overflow: hidden;
        background:
          linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.11),
            transparent 45%
          ),
          linear-gradient(
            145deg,
            var(--gift-card-heading),
            #27231e
          );
      }

      .gift-card-page__visual-panel::before,
      .gift-card-page__visual-panel::after {
        position: absolute;
        content: "";
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 50%;
      }

      .gift-card-page__visual-panel::before {
        top: -120px;
        right: -100px;
        width: 340px;
        height: 340px;
      }

      .gift-card-page__visual-panel::after {
        bottom: -170px;
        left: -120px;
        width: 430px;
        height: 430px;
      }

      .gift-card {
        position: relative;
        z-index: 2;
        width: min(100%, 490px);
        aspect-ratio: 1.58 / 1;
        padding: 34px;
        overflow: hidden;
        color: #ffffff;
        background:
          radial-gradient(
            circle at top right,
            rgba(255, 255, 255, 0.25),
            transparent 30%
          ),
          linear-gradient(
            135deg,
            var(--gift-card-accent),
            var(--gift-card-accent-dark)
          );
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 26px;
        box-shadow: 0 30px 65px rgba(0, 0, 0, 0.35);
        transform: rotate(-3deg);
        transition: transform 250ms ease;
      }

      .gift-card:hover {
        transform: rotate(0deg) translateY(-5px);
      }

      .gift-card::before {
        position: absolute;
        top: -120px;
        right: -90px;
        width: 290px;
        height: 290px;
        content: "";
        background: rgba(255, 255, 255, 0.12);
        border-radius: 50%;
      }

      .gift-card::after {
        position: absolute;
        right: -70px;
        bottom: -100px;
        width: 240px;
        height: 240px;
        content: "";
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50%;
      }

      .gift-card__top,
      .gift-card__bottom {
        position: relative;
        z-index: 2;
      }

      .gift-card__top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
      }

      .gift-card__brand {
        max-width: 170px;
      }

      .gift-card__brand img {
        width: auto;
        max-width: 160px;
        max-height: 52px;
        object-fit: contain;
        filter: brightness(0) invert(1);
      }

      .gift-card__brand-text {
        margin: 0;
        font-size: 21px;
        font-weight: 750;
        line-height: 1.2;
        letter-spacing: -0.03em;
      }

      .gift-card__label {
        margin: 0;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        opacity: 0.78;
      }

      .gift-card__amount {
        margin: 8px 0 0;
        font-size: clamp(36px, 5vw, 58px);
        font-weight: 750;
        line-height: 1;
        letter-spacing: -0.05em;
      }

      .gift-card__bottom {
        position: absolute;
        right: 34px;
        bottom: 30px;
        left: 34px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
      }

      .gift-card__number {
        margin: 5px 0 0;
        font-family: "Courier New", monospace;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: 0.12em;
      }

      .gift-card__chip {
        position: relative;
        width: 52px;
        height: 39px;
        flex: 0 0 auto;
        overflow: hidden;
        background: linear-gradient(145deg, #f5d992, #c9a658);
        border-radius: 8px;
        box-shadow: inset 0 0 0 1px rgba(77, 56, 20, 0.25);
      }

      .gift-card__chip::before,
      .gift-card__chip::after {
        position: absolute;
        content: "";
        background: rgba(81, 58, 18, 0.25);
      }

      .gift-card__chip::before {
        top: 0;
        bottom: 0;
        left: 50%;
        width: 1px;
      }

      .gift-card__chip::after {
        top: 50%;
        right: 0;
        left: 0;
        height: 1px;
      }

      .gift-card-page__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 64px 56px;
      }

      .gift-card-page__eyebrow {
        margin: 0 0 12px;
        color: var(--gift-card-accent);
        font-size: 12px;
        font-weight: 750;
        line-height: 1.4;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .gift-card-page__title {
        margin: 0;
        color: var(--gift-card-heading);
        font-size: clamp(34px, 4vw, 54px);
        font-weight: 760;
        line-height: 1.04;
        letter-spacing: -0.045em;
      }

      .gift-card-page__description {
        margin: 20px 0 0;
        color: var(--gift-card-text);
        font-size: 16px;
        line-height: 1.7;
      }

      .gift-card-page__status {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        padding: 9px 13px;
        color: #9c3d33;
        font-size: 13px;
        font-weight: 700;
        background: #fff0ed;
        border-radius: 999px;
      }

      .gift-card-page__status-dot {
        width: 8px;
        height: 8px;
        background: currentColor;
        border-radius: 50%;
      }

      .gift-card-page__details {
        display: grid;
        gap: 14px;
        margin-top: 34px;
      }

      .gift-card-page__detail {
        padding: 17px 18px;
        background: #faf9f7;
        border: 1px solid var(--gift-card-border);
        border-radius: 16px;
      }

      .gift-card-page__detail-label {
        display: block;
        margin-bottom: 6px;
        color: var(--gift-card-text);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .gift-card-page__detail-value {
        margin: 0;
        color: var(--gift-card-heading);
        font-size: 15px;
        font-weight: 650;
        line-height: 1.4;
      }

      .gift-card-page__code-wrapper {
        margin-top: 16px;
      }

      .gift-card-page__code {
        position: relative;
        display: flex;
        min-height: 62px;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 10px 10px 10px 20px;
        background: var(--gift-card-code-background);
        border: 1px dashed rgba(176, 138, 90, 0.5);
        border-radius: 16px;
      }

      .gift-card-page__code-text {
        overflow-wrap: anywhere;
        color: var(--gift-card-heading);
        font-family: "Courier New", monospace;
        font-size: 17px;
        font-weight: 750;
        line-height: 1.4;
        letter-spacing: 0.1em;
      }

      .gift-card-page__copy-button {
        display: inline-flex;
        width: 43px;
        height: 43px;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        cursor: pointer;
        background: var(--gift-card-heading);
        border: 0;
        border-radius: 12px;
        transition:
          transform 180ms ease,
          background-color 180ms ease;
      }

      .gift-card-page__copy-button:hover {
        background: var(--gift-card-accent);
        transform: translateY(-2px);
      }

      .gift-card-page__copy-button svg {
        width: 19px;
        height: 19px;
      }

      .gift-card-page__copy-message {
        min-height: 18px;
        margin: 8px 0 0;
        color: var(--gift-card-accent-dark);
        font-size: 12px;
        font-weight: 650;
      }

      .gift-card-page__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .gift-card-page__button {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 22px;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        text-decoration: none;
        background: var(--gift-card-heading);
        border: 1px solid var(--gift-card-heading);
        border-radius: 999px;
        transition:
          color 180ms ease,
          background-color 180ms ease,
          border-color 180ms ease,
          transform 180ms ease;
      }

      .gift-card-page__button:hover {
        background: var(--gift-card-accent);
        border-color: var(--gift-card-accent);
        transform: translateY(-2px);
      }

      .gift-card-page__button--secondary {
        color: var(--gift-card-heading);
        background: transparent;
        border-color: var(--gift-card-border);
      }

      .gift-card-page__button--secondary:hover {
        color: #ffffff;
      }

      .gift-card-page__button svg {
        width: 18px;
        height: 18px;
      }

      .gift-card-page__wallet {
        margin-top: 18px;
      }

      .gift-card-page__wallet img {
        width: auto;
        max-width: 180px;
        height: auto;
      }

      .gift-card-page__note {
        margin: 28px 0 0;
        color: var(--gift-card-text);
        font-size: 12px;
        line-height: 1.6;
      }

      .gift-card-page__footer {
        margin-top: 22px;
        text-align: center;
      }

      .gift-card-page__footer a {
        color: var(--gift-card-text);
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
      }

      .gift-card-page__footer a:hover {
        color: var(--gift-card-accent);
      }

      .gift-card-page__copy-button:focus-visible,
      .gift-card-page__button:focus-visible,
      .gift-card-page__brand:focus-visible,
      .gift-card-page__footer a:focus-visible,
      .gift-card-page__wallet a:focus-visible {
        outline: 2px solid var(--gift-card-accent);
        outline-offset: 3px;
      }

      @media screen and (max-width: 900px) {
        .gift-card-page__layout {
          grid-template-columns: 1fr;
        }

        .gift-card-page__visual-panel {
          min-height: auto;
          padding: 60px 40px;
        }

        .gift-card-page__content {
          padding: 52px 40px;
        }
      }

      @media screen and (max-width: 599px) {
        .gift-card-page {
          align-items: flex-start;
          padding: 28px 14px;
        }

        .gift-card-page__header {
          margin-bottom: 18px;
        }

        .gift-card-page__brand-name {
          font-size: 23px;
        }

        .gift-card-page__layout {
          border-radius: 22px;
        }

        .gift-card-page__visual-panel {
          padding: 42px 18px;
        }

        .gift-card {
          padding: 22px;
          border-radius: 20px;
          transform: none;
        }

        .gift-card:hover {
          transform: translateY(-3px);
        }

        .gift-card__bottom {
          right: 22px;
          bottom: 20px;
          left: 22px;
        }

        .gift-card__brand-text {
          font-size: 17px;
        }

        .gift-card__brand img {
          max-width: 120px;
          max-height: 40px;
        }

        .gift-card__amount {
          font-size: 35px;
        }

        .gift-card__number {
          font-size: 11px;
        }

        .gift-card__chip {
          width: 44px;
          height: 33px;
        }

        .gift-card-page__content {
          padding: 42px 22px;
        }

        .gift-card-page__title {
          font-size: 36px;
        }

        .gift-card-page__description {
          font-size: 15px;
        }

        .gift-card-page__code {
          padding-left: 15px;
        }

        .gift-card-page__code-text {
          font-size: 13px;
          letter-spacing: 0.06em;
        }

        .gift-card-page__actions {
          flex-direction: column;
        }

        .gift-card-page__button {
          width: 100%;
        }
      }

      @media print {
        body {
          background: #ffffff;
        }

        .gift-card-page {
          min-height: auto;
          padding: 0;
        }

        .gift-card-page__shape,
        .gift-card-page__actions,
        .gift-card-page__wallet,
        .gift-card-page__footer,
        .gift-card-page__copy-button,
        .gift-card-page__copy-message {
          display: none !important;
        }

        .gift-card-page__layout {
          box-shadow: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .gift-card,
        .gift-card-page__button,
        .gift-card-page__copy-button {
          transition: none;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main class="gift-card-page">
      <div
        class="gift-card-page__shape gift-card-page__shape--one"
        aria-hidden="true"
      ></div>

      <div
        class="gift-card-page__shape gift-card-page__shape--two"
        aria-hidden="true"
      ></div>

      <div class="gift-card-page__container">
        <header class="gift-card-page__header">
          <a
            class="gift-card-page__brand"
            href="{{ routes.root_url }}"
            aria-label="{{ shop.name | escape }}"
          >
            {% if settings.logo %}
              {{
                settings.logo
                | image_url: width: 440
                | image_tag:
                  widths: '160, 220, 320, 440',
                  sizes: '(max-width: 599px) 160px, 220px',
                  alt: shop.name
              }}
            {% else %}
              <p class="gift-card-page__brand-name">
                {{ shop.name }}
              </p>
            {% endif %}
          </a>
        </header>

        <div class="gift-card-page__layout">
          <div class="gift-card-page__visual-panel">
            <div class="gift-card">
              <div class="gift-card__top">
                <div class="gift-card__brand">
                  {% if settings.logo %}
                    {{
                      settings.logo
                      | image_url: width: 320
                      | image_tag:
                        widths: '120, 160, 240, 320',
                        sizes: '160px',
                        alt: shop.name
                    }}
                  {% else %}
                    <p class="gift-card__brand-text">
                      {{ shop.name }}
                    </p>
                  {% endif %}
                </div>

                <div class="gift-card__chip" aria-hidden="true"></div>
              </div>

              <div class="gift-card__bottom">
                <div>
                  <p class="gift-card__label">
                    {{ 'gift_card.card' | t }}
                  </p>

                  <p class="gift-card__amount">
                    {{ gift_card.balance | money }}
                  </p>

                  <p class="gift-card__number">
                    {{ gift_card.code | format_code }}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="gift-card-page__content">
            <p class="gift-card-page__eyebrow">
              {{ 'gift_card.card' | t }}
            </p>

            <h1 class="gift-card-page__title">
              {{ gift_card.balance | money }}
            </h1>

            <p class="gift-card-page__description">
              {{ 'gift_card.use_at_checkout' | t }}
            </p>

            {% if gift_card.enabled == false or gift_card.expired %}
              <div class="gift-card-page__status">
                <span
                  class="gift-card-page__status-dot"
                  aria-hidden="true"
                ></span>

                {{ 'gift_card.expired' | t }}
              </div>
            {% endif %}

            <div class="gift-card-page__details">
              <div class="gift-card-page__detail">
                <span class="gift-card-page__detail-label">
                  Available balance
                </span>

                <p class="gift-card-page__detail-value">
                  {{ gift_card.balance | money }}
                </p>
              </div>

              {% if gift_card.expires_on %}
                {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}

                <div class="gift-card-page__detail">
                  <span class="gift-card-page__detail-label">
                    Expiration date
                  </span>

                  <p class="gift-card-page__detail-value">
                    {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
                  </p>
                </div>
              {% endif %}
            </div>

            <div class="gift-card-page__code-wrapper">
              <span class="gift-card-page__detail-label">
                Gift card code
              </span>

              <div class="gift-card-page__code">
                <span
                  id="GiftCardCode"
                  class="gift-card-page__code-text"
                >
                  {{ gift_card.code | format_code }}
                </span>

                <button
                  id="GiftCardCopyButton"
                  class="gift-card-page__copy-button"
                  type="button"
                  aria-label="Copy gift card code"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                  >
                    <rect
                      x="8"
                      y="8"
                      width="11"
                      height="11"
                      rx="2"
                      stroke="currentColor"
                      stroke-width="1.8"
                    ></rect>

                    <path
                      d="M16 8V6C16 4.89543 15.1046 4 14 4H6C4.89543 4 4 4.89543 4 6V14C4 15.1046 4.89543 16 6 16H8"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    ></path>
                  </svg>
                </button>
              </div>

              <p
                id="GiftCardCopyMessage"
                class="gift-card-page__copy-message"
                aria-live="polite"
              ></p>
            </div>

            <div class="gift-card-page__actions">
              <a
                class="gift-card-page__button"
                href="{{ routes.all_products_collection_url }}"
              >
                Continue shopping

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M5 12H19"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  ></path>

                  <path
                    d="M14 7L19 12L14 17"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </a>

              <button
                class="gift-card-page__button gift-card-page__button--secondary"
                type="button"
                onclick="window.print();"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <path
                    d="M7 8V4H17V8"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>

                  <rect
                    x="5"
                    y="13"
                    width="14"
                    height="7"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.8"
                  ></rect>

                  <path
                    d="M5 16H3V10C3 8.89543 3.89543 8 5 8H19C20.1046 8 21 8.89543 21 10V16H19"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  ></path>

                  <circle
                    cx="17"
                    cy="11"
                    r="1"
                    fill="currentColor"
                  ></circle>
                </svg>

                Print gift card
              </button>
            </div>

            {% if gift_card.pass_url %}
              <div class="gift-card-page__wallet">
                <a href="{{ gift_card.pass_url }}">
                  <img
                    src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                    alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                    width="200"
                    height="60"
                    loading="lazy"
                  >
                </a>
              </div>
            {% endif %}

            <p class="gift-card-page__note">
              Enter this gift card code during checkout. Keep this page or code
              secure because anyone with access to it may use the available balance.
            </p>
          </div>
        </div>

        <footer class="gift-card-page__footer">
          <a href="{{ routes.root_url }}">
            Return to {{ shop.name }}
          </a>
        </footer>
      </div>
    </main>

    <script>
      (() => {
        const copyButton = document.getElementById('GiftCardCopyButton');
        const codeElement = document.getElementById('GiftCardCode');
        const messageElement = document.getElementById('GiftCardCopyMessage');

        if (!copyButton || !codeElement || !messageElement) return;

        copyButton.addEventListener('click', async () => {
          const code = codeElement.textContent.trim();

          try {
            await navigator.clipboard.writeText(code);
            messageElement.textContent = 'Gift card code copied.';
          } catch (error) {
            const textarea = document.createElement('textarea');

            textarea.value = code;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';

            document.body.appendChild(textarea);
            textarea.select();

            const copied = document.execCommand('copy');

            document.body.removeChild(textarea);

            messageElement.textContent = copied
              ? 'Gift card code copied.'
              : 'Unable to copy the code. Please copy it manually.';
          }

          window.setTimeout(() => {
            messageElement.textContent = '';
          }, 3000);
        });
      })();
    </script>
  </body>
</html>