    height: 21px;
  }

  .custom-product button:focus-visible,
  .custom-product select:focus-visible,
  .custom-product input:focus-visible,
  .custom-product summary:focus-visible {
    outline: 2px solid var(--product-accent-color);
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .custom-product__layout {
      grid-template-columns: 1fr;
    }

    .custom-product__information-inner {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-product__container {
      width: 100%;
      padding: 0 0 60px;
