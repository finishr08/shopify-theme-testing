    border: 1px solid var(--product-border-color);
    border-radius: 14px;
  }

  .custom-product__quantity-button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--product-heading-color);
    cursor: pointer;
    background: transparent;
    border: 0;
