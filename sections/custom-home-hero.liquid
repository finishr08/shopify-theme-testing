{% comment %}
  Custom Homepage Hero Section
  Built from scratch without theme-dependent classes.
{% endcomment %}

{% liquid
  assign section_id = 'custom-hero-' | append: section.id
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
%}

<section
  id="{{ section_id }}"
  class="custom-hero custom-hero--{{ section.settings.content_position }}"
  style="
    --hero-desktop-height: {{ section.settings.desktop_height }}px;
    --hero-mobile-height: {{ section.settings.mobile_height }}px;
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-content-width: {{ section.settings.content_width }}px;
    --hero-heading-color: {{ section.settings.heading_color }};
    --hero-text-color: {{ section.settings.text_color }};
    --hero-section-bg: {{ section.settings.background_color }};
    --hero-padding-desktop: {{ section.settings.desktop_horizontal_padding }}px;
    --hero-padding-mobile: {{ section.settings.mobile_horizontal_padding }}px;
  "
>
  <div class="custom-hero__media">
    {% if desktop_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 550 }} 550w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {% endif %}

        <img
          class="custom-hero__image"
          src="{{ desktop_image | image_url: width: 2000 }}"
          srcset="
            {{ desktop_image | image_url: width: 750 }} 750w,
            {{ desktop_image | image_url: width: 1100 }} 1100w,
            {{ desktop_image | image_url: width: 1500 }} 1500w,
            {{ desktop_image | image_url: width: 2000 }} 2000w,
            {{ desktop_image | image_url: width: 2400 }} 2400w
          "
          sizes="100vw"
          width="{{ desktop_image.width }}"
          height="{{ desktop_image.height }}"
          alt="{{ desktop_image.alt | default: section.settings.heading | escape }}"
          loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
          fetchpriority="{% if section.index == 1 %}high{% else %}auto{% endif %}"
        >
      </picture>
    {% else %}
      <div class="custom-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-hero__placeholder-svg' }}
      </div>
    {% endif %}

    <div class="custom-hero__overlay" aria-hidden="true"></div>
  </div>

  {% if section.settings.full_section_link != blank %}
    <a
      class="custom-hero__full-link"
      href="{{ section.settings.full_section_link }}"
      aria-label="{{ section.settings.full_section_link_label | default: section.settings.heading | escape }}"
    ></a>
  {% endif %}

  <div class="custom-hero__inner">
    <div class="custom-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="custom-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_tag }} class="custom-hero__heading">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="custom-hero__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
        <div class="custom-hero__buttons">
          {% if section.settings.primary_button_label != blank %}
            <a
              class="custom-hero__button custom-hero__button--primary"
              href="{{ section.settings.primary_button_link | default: '#' }}"
            >
              {{ section.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if section.settings.secondary_button_label != blank %}
            <a
              class="custom-hero__button custom-hero__button--secondary"
              href="{{ section.settings.secondary_button_link | default: '#' }}"
            >
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  #{{ section_id }} {
    position: relative;
    display: grid;
    width: 100%;
    min-height: var(--hero-desktop-height);
    overflow: hidden;
    isolation: isolate;
    background: var(--hero-section-bg);
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .custom-hero__media,
  #{{ section_id }} .custom-hero__inner {
    grid-area: 1 / 1;
  }

  #{{ section_id }} .custom-hero__media {
    position: relative;
    z-index: 0;
    width: 100%;
    min-height: inherit;
  }

  #{{ section_id }} .custom-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .custom-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: var(--hero-desktop-height);
    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position }};
  }

  #{{ section_id }} .custom-hero__placeholder {
    width: 100%;
    height: 100%;
    min-height: var(--hero-desktop-height);
    background: #eeeeee;
  }

  #{{ section_id }} .custom-hero__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: var(--hero-desktop-height);
    object-fit: cover;
  }

  #{{ section_id }} .custom-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--hero-overlay-color);
    opacity: var(--hero-overlay-opacity);
  }

  #{{ section_id }} .custom-hero__full-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  #{{ section_id }} .custom-hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    width: 100%;
    min-height: inherit;
    padding: 60px var(--hero-padding-desktop);
    pointer-events: none;
  }

  #{{ section_id }} .custom-hero__content {
    width: min(100%, var(--hero-content-width));
    pointer-events: auto;
  }

  #{{ section_id }}.custom-hero--top-left .custom-hero__inner {
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
  }

  #{{ section_id }}.custom-hero--top-center .custom-hero__inner {
    align-items: flex-start;
    justify-content: center;
    text-align: center;
  }

  #{{ section_id }}.custom-hero--top-right .custom-hero__inner {
    align-items: flex-start;
    justify-content: flex-end;
    text-align: right;
  }

  #{{ section_id }}.custom-hero--center-left .custom-hero__inner {
    align-items: center;
    justify-content: flex-start;
    text-align: left;
  }

  #{{ section_id }}.custom-hero--center .custom-hero__inner {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  #{{ section_id }}.custom-hero--center-right .custom-hero__inner {
    align-items: center;
    justify-content: flex-end;
    text-align: right;
  }

  #{{ section_id }}.custom-hero--bottom-left .custom-hero__inner {
    align-items: flex-end;
    justify-content: flex-start;
    text-align: left;
  }

  #{{ section_id }}.custom-hero--bottom-center .custom-hero__inner {
    align-items: flex-end;
    justify-content: center;
    text-align: center;
  }

  #{{ section_id }}.custom-hero--bottom-right .custom-hero__inner {
    align-items: flex-end;
    justify-content: flex-end;
    text-align: right;
  }

  #{{ section_id }} .custom-hero__eyebrow {
    margin: 0 0 14px;
    color: var(--hero-text-color);
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ section_id }} .custom-hero__heading {
    margin: 0;
    color: var(--hero-heading-color);
    font-family: inherit;
    font-size: clamp(
      {{ section.settings.mobile_heading_size }}px,
      5vw,
      {{ section.settings.desktop_heading_size }}px
    );
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  #{{ section_id }} .custom-hero__description {
    margin-top: 20px;
    color: var(--hero-text-color);
    font-size: {{ section.settings.description_size }}px;
    line-height: 1.6;
  }

  #{{ section_id }} .custom-hero__description > * {
    margin-top: 0;
  }

  #{{ section_id }} .custom-hero__description > *:last-child {
    margin-bottom: 0;
  }

  #{{ section_id }} .custom-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  #{{ section_id }}.custom-hero--top-center .custom-hero__buttons,
  #{{ section_id }}.custom-hero--center .custom-hero__buttons,
  #{{ section_id }}.custom-hero--bottom-center .custom-hero__buttons {
    justify-content: center;
  }

  #{{ section_id }}.custom-hero--top-right .custom-hero__buttons,
  #{{ section_id }}.custom-hero--center-right .custom-hero__buttons,
  #{{ section_id }}.custom-hero--bottom-right .custom-hero__buttons {
    justify-content: flex-end;
  }

  #{{ section_id }} .custom-hero__button {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 150px;
    min-height: 50px;
    padding: 13px 26px;
    border: 1px solid transparent;
    border-radius: {{ section.settings.button_radius }}px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  #{{ section_id }} .custom-hero__button:hover {
    transform: translateY(-2px);
  }

  #{{ section_id }} .custom-hero__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  #{{ section_id }} .custom-hero__button--primary {
    color: {{ section.settings.primary_button_text_color }};
    background: {{ section.settings.primary_button_background }};
    border-color: {{ section.settings.primary_button_background }};
  }

  #{{ section_id }} .custom-hero__button--primary:hover {
    color: {{ section.settings.primary_button_hover_text }};
    background: {{ section.settings.primary_button_hover_background }};
    border-color: {{ section.settings.primary_button_hover_background }};
  }

  #{{ section_id }} .custom-hero__button--secondary {
    color: {{ section.settings.secondary_button_text_color }};
    background: {{ section.settings.secondary_button_background }};
    border-color: {{ section.settings.secondary_button_border }};
  }

  #{{ section_id }} .custom-hero__button--secondary:hover {
    color: {{ section.settings.secondary_button_hover_text }};
    background: {{ section.settings.secondary_button_hover_background }};
    border-color: {{ section.settings.secondary_button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      min-height: var(--hero-mobile-height);
    }

    #{{ section_id }} .custom-hero__image,
    #{{ section_id }} .custom-hero__placeholder,
    #{{ section_id }} .custom-hero__placeholder-svg {
      min-height: var(--hero-mobile-height);
    }

    #{{ section_id }} .custom-hero__image {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #{{ section_id }} .custom-hero__inner {
      align-items: {{ section.settings.mobile_vertical_position }};
      justify-content: {{ section.settings.mobile_horizontal_position }};
      padding: 40px var(--hero-padding-mobile);
      text-align: {{ section.settings.mobile_text_alignment }};
    }

    #{{ section_id }} .custom-hero__content {
      width: 100%;
    }

    #{{ section_id }} .custom-hero__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
    }

    #{{ section_id }} .custom-hero__description {
      font-size: {{ section.settings.mobile_description_size }}px;
    }

    #{{ section_id }} .custom-hero__buttons {
      flex-direction: {% if section.settings.stack_buttons_mobile %}column{% else %}row{% endif %};
      justify-content:
        {% case section.settings.mobile_text_alignment %}
          {% when 'center' %}center
          {% when 'right' %}flex-end
          {% else %}flex-start
        {% endcase %};
    }

    {% if section.settings.stack_buttons_mobile %}
      #{{ section_id }} .custom-hero__button {
        width: 100%;
      }
    {% endif %}
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .custom-hero__button {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
