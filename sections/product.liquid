    .custom-product__layout {
      gap: 32px;
    }

    .custom-product__gallery {
      display: flex;
      flex-direction: column-reverse;
      gap: 12px;
    }

    .custom-product__main-media {
      border-right: 0;
      border-left: 0;
      border-radius: 0;
    }

    .custom-product__image {
      min-height: 430px;
    }

    .custom-product__thumbnails {
      flex-direction: row;
      max-height: none;
      padding: 0 16px 4px;
      overflow-x: auto;
    }

    .custom-product__thumbnail {
      width: 68px;
      height: 78px;
      flex: 0 0 auto;
    }

    .custom-product__information {
      padding: 0 18px;
    }

    .custom-product__title {
      font-size: 38px;
    }

    .custom-product__purchase-row {
      grid-template-columns: 1fr;
    }

    .custom-product__quantity {
      width: 140px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-product__thumbnail,
    .custom-product__add-button,
    .custom-product__accordion summary svg {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('ProductSection-{{ section.id }}');

    if (!section) return;

    const variantSelect = section.querySelector('[data-variant-select]');
    const variantInput = section.querySelector('[data-variant-id]');
    const price = section.querySelector('[data-product-price]');
    const comparePrice = section.querySelector('[data-product-compare-price]');
    const availability = section.querySelector('[data-product-availability]');
    const availabilityText = section.querySelector('[data-product-availability-text]');
    const skuWrapper = section.querySelector('[data-product-sku-wrapper]');
    const sku = section.querySelector('[data-product-sku]');
    const addButton = section.querySelector('[data-add-to-cart]');
    const addButtonText = section.querySelector('[data-add-to-cart-text]');
    const dynamicCheckout = section.querySelector('[data-dynamic-checkout]');
    const quantityInput = section.querySelector('[data-quantity-input]');
    const minusButton = section.querySelector('[data-quantity-minus]');
    const plusButton = section.querySelector('[data-quantity-plus]');
    const thumbnails = section.querySelectorAll('[data-product-thumbnail]');
    const mediaItems = section.querySelectorAll('[data-product-media]');
    const zoomButtons = section.querySelectorAll('[data-product-zoom]');
    const lightbox = section.querySelector('[data-product-lightbox]');
    const lightboxImage = section.querySelector('[data-lightbox-image]');
    const lightboxClose = section.querySelector('[data-lightbox-close]');
    const lowStockThreshold = {{ section.settings.low_stock_threshold | json }};

    const activateMedia = (mediaId) => {
      if (!mediaId) return;

      mediaItems.forEach((item) => {
        const active = item.dataset.mediaId === String(mediaId);

        item.hidden = !active;
        item.classList.toggle('is-active', active);
      });

      thumbnails.forEach((thumbnail) => {
        const active = thumbnail.dataset.mediaId === String(mediaId);

        thumbnail.classList.toggle('is-active', active);
        thumbnail.setAttribute('aria-current', active ? 'true' : 'false');
      });
    };

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener('click', () => {
        activateMedia(thumbnail.dataset.mediaId);
      });
    });

    if (variantSelect) {
      variantSelect.addEventListener('change', () => {
        const option = variantSelect.options[variantSelect.selectedIndex];
        const available = option.dataset.available === 'true';
        const inventory = Number(option.dataset.inventory || 0);
        const compareValue = Number(option.dataset.comparePrice || 0);
        const priceValue = Number(option.dataset.price || 0);
        const selectedSku = option.dataset.sku || '';
        const mediaId = option.dataset.mediaId;
        const variantUrl = option.dataset.url;

        variantInput.value = option.value;
        price.textContent = option.dataset.priceFormatted;

        if (compareValue > priceValue) {
          comparePrice.textContent = option.dataset.comparePriceFormatted;
          comparePrice.hidden = false;
        } else {
          comparePrice.textContent = '';
          comparePrice.hidden = true;
        }

        availability.classList.toggle('is-available', available);
        availability.classList.toggle('is-unavailable', !available);

        if (available) {
          availabilityText.textContent =
            inventory > 0 && inventory <= lowStockThreshold
              ? `Only ${inventory} left in stock`
              : 'In stock and ready to ship';

          addButton.disabled = false;
          addButtonText.textContent = 'Add to cart';

          if (dynamicCheckout) {
            dynamicCheckout.hidden = false;
          }
        } else {
          availabilityText.textContent = 'Currently unavailable';
          addButton.disabled = true;
          addButtonText.textContent = 'Sold out';

          if (dynamicCheckout) {
            dynamicCheckout.hidden = true;
          }
        }

        if (sku && skuWrapper) {
          sku.textContent = selectedSku;
          skuWrapper.hidden = selectedSku.length === 0;
        }

        if (mediaId) {
          activateMedia(mediaId);
        }

        if (variantUrl && window.history.replaceState) {
          window.history.replaceState({}, '', variantUrl);
        }
      });
    }

    if (minusButton && quantityInput) {
      minusButton.addEventListener('click', () => {
        const currentValue = Number(quantityInput.value) || 1;
        quantityInput.value = Math.max(1, currentValue - 1);
      });
    }

    if (plusButton && quantityInput) {
      plusButton.addEventListener('click', () => {
        const currentValue = Number(quantityInput.value) || 1;
        quantityInput.value = currentValue + 1;
      });
    }

    if (quantityInput) {
      quantityInput.addEventListener('change', () => {
        const value = Number(quantityInput.value);

        if (!Number.isInteger(value) || value < 1) {
          quantityInput.value = 1;
        }
      });
    }

    zoomButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!lightbox || !lightboxImage) return;

        const image = button.querySelector('img');

        if (!image) return;

        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt;

        if (typeof lightbox.showModal === 'function') {
          lightbox.showModal();
        }
      });
    });

    if (lightboxClose && lightbox) {
      lightboxClose.addEventListener('click', () => {
        lightbox.close();
      });

      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) {
          lightbox.close();
        }
      });
    }
  })();
</script>

