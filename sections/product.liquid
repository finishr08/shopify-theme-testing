    right: 14px;
    z-index: 2;
    display: flex;
    width: 43px;
    height: 43px;
    align-items: center;
    justify-content: center;
    color: #111111;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.9);
    border: 0;
    border-radius: 50%;
