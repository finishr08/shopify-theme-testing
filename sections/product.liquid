{% comment %}
  Professional product page section.
  Built from scratch for Shopify Skeleton theme.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'ProductForm-' | append: section.id
%}

<section
  id="ProductSection-{{ section.id }}"
  class="custom-product full-width"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  style="
    --product-background: {{ section.settings.background_color }};
    --product-card-background: {{ section.settings.card_background }};
    --product-heading-color: {{ section.settings.heading_color }};
    --product-text-color: {{ section.settings.text_color }};
    --product-muted-color: {{ section.settings.muted_color }};
    --product-accent-color: {{ section.settings.accent_color }};
    --product-button-background: {{ section.settings.button_background }};
    --product-button-color: {{ section.settings.button_text_color }};
    --product-button-hover: {{ section.settings.button_hover_background }};
    --product-border-color: {{ section.settings.border_color }};
    --product-radius: {{ section.settings.card_radius }}px;
    --product-width: {{ section.settings.content_width }}px;
  "
>
  <div class="custom-product__container">
    <div class="custom-product__layout">
      <div class="custom-product__media">
        {% if product.media.size > 0 %}
          <div class="custom-product__gallery">
            {% if product.media.size > 1 %}
              <div
                class="custom-product__thumbnails"
                role="list"
                aria-label="Product media thumbnails"
              >
                {% for media in product.media %}
                  {% if media.media_type == 'image' %}
                    <button
                      type="button"
                      class="custom-product__thumbnail{% if media.id == featured_media.id %} is-active{% endif %}"
                      data-product-thumbnail
                      data-media-id="{{ media.id }}"
                      aria-label="View image {{ forloop.index }}"
                      aria-current="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
                    >
                      {{
                        media.preview_image
                        | image_url: width: 180
                        | image_tag:
                          loading: 'lazy',
                          widths: '80, 120, 180',
                          sizes: '80px',
                          alt: media.alt
                      }}
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <div class="custom-product__main-media">
              {% for media in product.media %}
                <div
                  class="custom-product__media-item{% if media.id == featured_media.id %} is-active{% endif %}"
                  data-product-media
                  data-media-id="{{ media.id }}"
                  {% unless media.id == featured_media.id %}
                    hidden
                  {% endunless %}
                >
                  {% case media.media_type %}
                    {% when 'image' %}
                      <button
                        type="button"
                        class="custom-product__image-button"
                        data-product-zoom
                        aria-label="Enlarge product image"
                      >
                        {{
                          media
                          | image_url: width: 1800
                          | image_tag:
                            class: 'custom-product__image',
                            loading: 'eager',
                            fetchpriority: 'high',
                            widths: '550, 750, 1000, 1300, 1600, 1800',
                            sizes: '(max-width: 989px) 100vw, 55vw',
                            alt: media.alt
                        }}

                        <span class="custom-product__zoom-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none">
                            <circle
                              cx="10.5"
                              cy="10.5"
                              r="6.5"
                              stroke="currentColor"
                              stroke-width="1.7"
                            ></circle>
                            <path
                              d="M15.5 15.5L21 21"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"
                            ></path>
                            <path
                              d="M10.5 7.5V13.5M7.5 10.5H13.5"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"
                            ></path>
                          </svg>
                        </span>
                      </button>

                    {% when 'video' %}
                      {{
                        media
                        | video_tag:
                          class: 'custom-product__video',
                          controls: true,
                          preload: 'metadata'
                      }}

                    {% when 'external_video' %}
                      {{
                        media
                        | external_video_tag:
                          class: 'custom-product__video'
                      }}

                    {% when 'model' %}
                      {{
                        media
                        | model_viewer_tag:
                          class: 'custom-product__model',
                          reveal: 'interaction',
                          toggleable: true
                      }}
                  {% endcase %}
                </div>
              {% endfor %}

              {% if section.settings.show_sale_badge and current_variant.compare_at_price > current_variant.price %}
                <span class="custom-product__badge custom-product__badge--sale">
                  Sale
                </span>
              {% endif %}

              {% unless current_variant.available %}
                <span class="custom-product__badge custom-product__badge--sold-out">
                  Sold out
                </span>
              {% endunless %}
            </div>
          </div>
        {% else %}
          <div class="custom-product__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'custom-product__placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <div class="custom-product__information">
        <div class="custom-product__information-inner">
          {% if section.settings.show_vendor and product.vendor != blank %}
            <p class="custom-product__vendor">
              {{ product.vendor | escape }}
            </p>
          {% endif %}

          <h1 class="custom-product__title">
            {{ product.title | escape }}
          </h1>

          {% if section.settings.show_rating %}
            <div class="custom-product__rating">
              <div class="custom-product__stars" aria-hidden="true">
                {% for index in (1..5) %}
                  <svg viewBox="0 0 20 20">
                    <path
                      d="M10 1.7L12.5 6.8L18.1 7.6L14 11.6L15 17.2L10 14.6L5 17.2L6 11.6L1.9 7.6L7.5 6.8L10 1.7Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                {% endfor %}
              </div>

              <span>{{ section.settings.rating_text | escape }}</span>
            </div>
          {% endif %}

          <div class="custom-product__price-wrapper">
            <span
              class="custom-product__price"
              data-product-price
            >
              {{ current_variant.price | money }}
            </span>

            <span
              class="custom-product__compare-price"
              data-product-compare-price
              {% unless current_variant.compare_at_price > current_variant.price %}
                hidden
              {% endunless %}
            >
              {% if current_variant.compare_at_price > current_variant.price %}
                {{ current_variant.compare_at_price | money }}
              {% endif %}
            </span>

            {% if section.settings.show_price_note %}
              <span class="custom-product__price-note">
                {{ section.settings.price_note | escape }}
              </span>
            {% endif %}
          </div>

          {% if section.settings.show_short_description and product.description != blank %}
            <div class="custom-product__short-description">
              {{ product.description | strip_html | truncatewords: section.settings.description_words }}
            </div>
          {% endif %}

          {% form 'product',
            product,
            id: product_form_id,
            class: 'custom-product__form',
            novalidate: 'novalidate'
          %}
            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              data-variant-id
            >

            {% unless product.has_only_default_variant %}
              <div class="custom-product__variant-picker">
                <label
                  class="custom-product__field-label"
                  for="VariantSelect-{{ section.id }}"
                >
                  Choose an available option
                </label>

                <div class="custom-product__select-wrapper">
                  <select
                    id="VariantSelect-{{ section.id }}"
                    class="custom-product__select"
                    data-variant-select
                  >
                    {% for variant in product.variants %}
                      <option
                        value="{{ variant.id }}"
                        data-price="{{ variant.price }}"
                        data-price-formatted="{{ variant.price | money | escape }}"
                        data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                        data-compare-price-formatted="{{ variant.compare_at_price | money | escape }}"
                        data-available="{{ variant.available }}"
                        data-sku="{{ variant.sku | escape }}"
                        data-media-id="{{ variant.featured_media.id }}"
                        data-url="{{ variant.url }}"
                        data-inventory="{{ variant.inventory_quantity }}"
                        {% if variant.id == current_variant.id %}
                          selected
                        {% endif %}
                      >
                        {{ variant.title }}
                        —
                        {{ variant.price | money }}
                        {% unless variant.available %}
                          — Sold out
                        {% endunless %}
                      </option>
                    {% endfor %}
                  </select>

                  <svg
                    class="custom-product__select-icon"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 7.5L10 12.5L15 7.5"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
              </div>
            {% endunless %}

            <div class="custom-product__availability-row">
              <div
                class="custom-product__availability{% if current_variant.available %} is-available{% else %} is-unavailable{% endif %}"
                data-product-availability
                role="status"
              >
                <span class="custom-product__availability-dot"></span>

                <span data-product-availability-text>
                  {% if current_variant.available %}
                    {% if current_variant.inventory_management and current_variant.inventory_quantity > 0 %}
                      {% if current_variant.inventory_quantity <= section.settings.low_stock_threshold %}
                        Only {{ current_variant.inventory_quantity }} left in stock
                      {% else %}
                        In stock and ready to ship
                      {% endif %}
                    {% else %}
                      Available
                    {% endif %}
                  {% else %}
                    Currently unavailable
                  {% endif %}
                </span>
              </div>

              {% if section.settings.show_sku %}
                <p
                  class="custom-product__sku"
                  data-product-sku-wrapper
                  {% if current_variant.sku == blank %}
                    hidden
                  {% endif %}
                >
                  SKU:
                  <span data-product-sku>{{ current_variant.sku }}</span>
                </p>
              {% endif %}
            </div>

            <div class="custom-product__purchase-row">
              <div class="custom-product__quantity">
                <label
                  class="custom-product__field-label"
                  for="Quantity-{{ section.id }}"
                >
                  Quantity
                </label>

                <div class="custom-product__quantity-control">
                  <button
                    type="button"
                    class="custom-product__quantity-button"
                    data-quantity-minus
                    aria-label="Decrease quantity"
                  >
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path
                        d="M4 10H16"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      ></path>
                    </svg>
                  </button>

                  <input
                    id="Quantity-{{ section.id }}"
                    class="custom-product__quantity-input"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    inputmode="numeric"
                    data-quantity-input
                  >

                  <button
                    type="button"
                    class="custom-product__quantity-button"
                    data-quantity-plus
                    aria-label="Increase quantity"
                  >
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path
                        d="M4 10H16M10 4V16"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      ></path>
                    </svg>
                  </button>
                </div>
              </div>

              <button
                type="submit"
                name="add"
                class="custom-product__add-button"
                data-add-to-cart
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M3 4H5L7.3 15.2C7.5 16.2 8.4 17 9.5 17H18C19 17 19.8 16.4 20.1 15.5L22 8H7"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                  <circle cx="10" cy="21" r="1.3" fill="currentColor"></circle>
                  <circle cx="18" cy="21" r="1.3" fill="currentColor"></circle>
                </svg>

                <span data-add-to-cart-text>
                  {% if current_variant.available %}
                    Add to cart
                  {% else %}
                    Sold out
                  {% endif %}
                </span>
              </button>
            </div>

            {% if section.settings.show_dynamic_checkout %}
              <div
                class="custom-product__dynamic-checkout"
                data-dynamic-checkout
                {% unless current_variant.available %}
                  hidden
                {% endunless %}
              >
                {{ form | payment_button }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="custom-product__form-error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
          {% endform %}

          {% if section.settings.show_benefits %}
            <div class="custom-product__benefits">
              <div class="custom-product__benefit">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M3 7H15V18H3V7Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                  ></path>
                  <path
                    d="M15 11H19L22 14V18H15V11Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                  ></path>
                  <circle cx="7" cy="19" r="2" stroke="currentColor" stroke-width="1.6"></circle>
                  <circle cx="18" cy="19" r="2" stroke="currentColor" stroke-width="1.6"></circle>
                </svg>

                <div>
                  <strong>{{ section.settings.delivery_heading | escape }}</strong>
                  <span>{{ section.settings.delivery_text | escape }}</span>
                </div>
              </div>

              <div class="custom-product__benefit">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M12 3L20 6V11C20 16.2 16.7 20.5 12 22C7.3 20.5 4 16.2 4 11V6L12 3Z"
                    stroke="currentColor"
                    stroke-width="1.6"
                  ></path>
                  <path
                    d="M8.5 12L11 14.5L15.5 10"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>

                <div>
                  <strong>{{ section.settings.secure_heading | escape }}</strong>
                  <span>{{ section.settings.secure_text | escape }}</span>
                </div>
              </div>

              <div class="custom-product__benefit">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M6 8L3 11L6 14"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                  <path
                    d="M3 11H15C18.3 11 21 13.7 21 17C21 20.3 18.3 23 15 23H11"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  ></path>
                </svg>

                <div>
                  <strong>{{ section.settings.returns_heading | escape }}</strong>
                  <span>{{ section.settings.returns_text | escape }}</span>
                </div>
              </div>
            </div>
          {% endif %}

          {% if section.settings.show_description and product.description != blank %}
            <details class="custom-product__accordion" open>
              <summary>
                <span>Product details</span>

                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M5 7.5L10 12.5L15 7.5"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </summary>

              <div class="custom-product__description rte">
                {{ product.description }}
              </div>
            </details>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <dialog
    class="custom-product__lightbox"
    data-product-lightbox
    aria-label="Product image preview"
  >
    <button
      type="button"
      class="custom-product__lightbox-close"
      data-lightbox-close
      aria-label="Close image preview"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5 5L19 19M19 5L5 19"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <img
      class="custom-product__lightbox-image"
      data-lightbox-image
      src=""
      alt=""
      width="1800"
      height="1800"
    >
  </dialog>
</section>

{% stylesheet %}
  .custom-product {
    width: 100%;
    color: var(--product-heading-color);
    background: var(--product-background);
  }

  .custom-product *,
  .custom-product *::before,
  .custom-product *::after {
    box-sizing: border-box;
  }

  .custom-product button,
  .custom-product input,
  .custom-product select {
    font: inherit;
  }

  .custom-product__container {
    width: min(calc(100% - 48px), var(--product-width));
    margin: 0 auto;
    padding: 64px 0 96px;
  }

  .custom-product__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(390px, 0.9fr);
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
  }

  .custom-product__media {
    min-width: 0;
  }

  .custom-product__gallery {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 18px;
  }

  .custom-product__thumbnails {
    display: flex;
    max-height: 760px;
    flex-direction: column;
    gap: 12px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .custom-product__thumbnail {
    display: block;
    width: 82px;
    height: 98px;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background: var(--product-card-background);
    border: 1px solid var(--product-border-color);
    border-radius: 12px;
    opacity: 0.65;
    transition:
      opacity 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .custom-product__thumbnail:hover,
  .custom-product__thumbnail.is-active {
    border-color: var(--product-accent-color);
    opacity: 1;
  }

  .custom-product__thumbnail:hover {
    transform: translateY(-2px);
  }

  .custom-product__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
.custom-product__main-media {
  position: relative;
  width: 100%;
  height: 650px;
  overflow: hidden;
  background: var(--product-card-background);
  border: 1px solid var(--product-border-color);
  border-radius: var(--product-radius);
}

.custom-product__media-item {
  width: 100%;
  height: 100%;
}

.custom-product__image-button {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  padding: 0;
  cursor: zoom-in;
  background: transparent;
  border: 0;
}

.custom-product__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}

  .custom-product__video,
  .custom-product__model {
    width: 100%;
    min-height: 650px;
  }

  .custom-product__zoom-icon {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--product-heading-color);
    background: rgba(255, 255, 255, 0.88);
    border-radius: 50%;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
  }

  .custom-product__zoom-icon svg {
    width: 20px;
    height: 20px;
  }

  .custom-product__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: inline-flex;
    padding: 8px 13px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .custom-product__badge--sale {
    background: var(--product-accent-color);
  }

  .custom-product__badge--sold-out {
    background: #292929;
  }

  .custom-product__placeholder {
    min-height: 600px;
    overflow: hidden;
    background: var(--product-card-background);
    border-radius: var(--product-radius);
  }

  .custom-product__placeholder-svg {
    width: 100%;
    height: 600px;
  }

  .custom-product__information {
    min-width: 0;
  }

  .custom-product__information-inner {
    position: sticky;
    top: 30px;
  }

  .custom-product__vendor {
    margin: 0 0 12px;
    color: var(--product-accent-color);
    font-size: 12px;
    font-weight: 750;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .custom-product__title {
    margin: 0;
    color: var(--product-heading-color);
    font-size: clamp(36px, 4.5vw, 62px);
    font-weight: 760;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .custom-product__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 17px;
    color: var(--product-muted-color);
    font-size: 13px;
  }

  .custom-product__stars {
    display: flex;
    gap: 3px;
    color: #f5a623;
  }

  .custom-product__stars svg {
    width: 17px;
    height: 17px;
  }

  .custom-product__price-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-top: 24px;
  }

  .custom-product__price {
    color: var(--product-heading-color);
    font-size: 30px;
    font-weight: 750;
    line-height: 1.2;
  }

  .custom-product__compare-price {
    color: var(--product-muted-color);
    font-size: 18px;
    text-decoration: line-through;
  }

  .custom-product__price-note {
    width: 100%;
    color: var(--product-muted-color);
    font-size: 12px;
  }

  .custom-product__short-description {
    margin-top: 24px;
    color: var(--product-text-color);
    font-size: 16px;
    line-height: 1.75;
  }

  .custom-product__form {
    margin-top: 32px;
  }

  .custom-product__field-label {
    display: block;
    margin-bottom: 9px;
    color: var(--product-heading-color);
    font-size: 13px;
    font-weight: 700;
  }

  .custom-product__select-wrapper {
    position: relative;
  }

  .custom-product__select {
    width: 100%;
    min-height: 56px;
    padding: 0 52px 0 18px;
    color: var(--product-heading-color);
    cursor: pointer;
    appearance: none;
    background: var(--product-card-background);
    border: 1px solid var(--product-border-color);
    border-radius: 14px;
    outline: none;
  }

  .custom-product__select:focus {
    border-color: var(--product-accent-color);
  }

  .custom-product__select-icon {
    position: absolute;
    top: 50%;
    right: 18px;
    width: 19px;
    height: 19px;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .custom-product__availability-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }

  .custom-product__availability {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--product-muted-color);
    font-size: 13px;
    font-weight: 600;
  }

  .custom-product__availability-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    background: currentColor;
    border-radius: 50%;
  }

  .custom-product__availability.is-available {
    color: #227a45;
  }

